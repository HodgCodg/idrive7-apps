{
  "id": "hba_assist",
  "title": "High Beam Assistant",
  "description": "High beam assistant: read-only checks (stalk button, KAFAS enabling code, cluster indicator, faults) and BMW's own HBA demo jobs as guarded live-diagnostic experiments",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "HBA",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "High Beam Assistant",
      "buttons": [
        [
          "BTN_RUN",
          "Run checks"
        ],
        [
          "BTN_BUTTON",
          "Button test"
        ],
        [
          "BTN_EXP",
          "Start / stop experiment"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "experiment",
      "label": "Experiment",
      "type": "choice",
      "default": "off",
      "markDefault": true,
      "options": [
        [
          "off",
          "Off (nothing is sent)"
        ],
        [
          "kafas",
          "E1: KAFAS demo mode"
        ],
        [
          "bdc",
          "E2: BDC demo routine"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "ice",
      "options": [
        [
          "ice",
          "Ice White"
        ],
        [
          "m_red",
          "M Red"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
